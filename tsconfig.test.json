{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      // @tapylet/core publishes its subpaths through "exports", which the
      // node10 resolution above does not read. Jest resolves them at run time;
      // this is what lets the compiler follow the same imports.
      "@tapylet/core/*": ["./node_modules/@tapylet/core/dist/*"]
    },
    "types": ["jest", "node"],
    "allowJs": true,
    "noImplicitAny": false
  },
  "include": ["test/**/*.test.ts", "src/**/*.ts", "src/**/*.js"],
  "exclude": ["node_modules"]
}
